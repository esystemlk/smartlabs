{
  "expo": {
    "name": "SmartLabs PTE",
    "slug": "smartlabs-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "smartlabs",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "lk.smartlabs.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "SmartLabs needs the microphone to record your speaking answers for AI scoring."
      }
    },
    "android": {
      "package": "lk.smartlabs.app",
      "permissions": ["RECORD_AUDIO"],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-av",
        {
          "microphonePermission": "SmartLabs needs the microphone to record your speaking answers for AI scoring."
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://www.smartlabs.lk",
      "googleWebClientId": "",
      "googleIosClientId": "",
      "googleAndroidClientId": ""
    }
  }
}
