{
  "expo": {
    "name": "SmartLabs PTE",
    "slug": "smartlabs-app",
    "version": "0.1.0",
    "runtimeVersion": "1.0.0",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "scheme": "smartlabs",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "lk.smartlabs.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "SmartLabs needs the microphone to record your speaking answers for AI scoring."
      }
    },
    "android": {
      "package": "lk.smartlabs.app",
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-router",
      "@react-native-google-signin/google-signin",
      "expo-notifications",
      [
        "expo-av",
        {
          "microphonePermission": "SmartLabs needs the microphone to record your speaking answers for AI scoring."
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://www.smartlabs.lk",
      "payhereSandbox": false,
      "googleWebClientId": "43848204138-84j5v663lq8hcednhkavddhkljl626s0.apps.googleusercontent.com",
      "googleIosClientId": "",
      "googleAndroidClientId": "43848204138-mq4gr6plbvf1oop55bq1pbokvnh6fj6d.apps.googleusercontent.com",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "94071082-95d8-441a-b320-f65119f4ce18"
      }
    }
  }
}
